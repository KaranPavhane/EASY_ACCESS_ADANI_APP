<core:FragmentDefinition xmlns="sap.m" xmlns:f="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc" xmlns:l="sap.ui.layout" height="100%"
	xmlns:t="sap.ui.table" xmlns:dnd="sap.ui.core.dnd" displayBlock="true" xmlns:core="sap.ui.core">
	<Page title="Authorization Tab" titleLevel="H1" backgroundDesign="Transparent" floatingFooter="true" showFooter="true">
		<content width="90%">
			<t:Table class="sapUiSizeCompact" id="authTab" visibleRowCount="15" rows="{/myItems}" ariaLabelledBy="title" selectionMode="None">
				<t:columns>
					<t:Column hAlign="Center" autoResizable="true">
						<Text text="Connector"/>
						<t:template>
							<Text text="{RFCDEST}"/>
						</t:template>
					</t:Column>
					<t:Column hAlign="Center" autoResizable="true">
						<Text text="User Name"/>
						<t:template>
							<Text text="{BNAME}"/>
						</t:template>
					</t:Column>
					<t:Column hAlign="Center" autoResizable="true">
						<Text text="Object"/>
						<t:template>
							<Text text="{OBJCT}"/>
						</t:template>
					</t:Column>
					<t:Column hAlign="Center" width="20rem" autoResizable="true">
						<Text text="Tcode"/>
						<t:template>
							<Text text="{TCODE}"/>
						</t:template>
					</t:Column>
					<t:Column hAlign="Center" width="15rem" autoResizable="true">
						<Text text="Action"/>
						<t:template>
							<HBox justifyContent="Center">
								<Button text="Get it Now" type="Reject" press="onGetAuthPage"/>
								<Button text="Ignore" press="handleDetailsPress" type="Ghost"/>
							</HBox>
						</t:template>
					</t:Column>
				</t:columns>
			</t:Table>
		</content>
	</Page>
</core:FragmentDefinition>