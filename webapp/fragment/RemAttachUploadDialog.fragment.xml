<core:FragmentDefinition controllerName="inforUI.controller.Upload" xmlns:u="sap.ui.unified" xmlns="sap.m" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core">
	<Dialog id="RemhelloDialog" title="Upload Attachment">
		<content>
			<form:SimpleForm>
				<form:content>
					<VBox>
						<Label text="Select file"></Label>
						<u:FileUploader id="idRemfileUploader" buttonText="" change="onFileSelect"
						fileType="css,html,htm,txt,rtx,xml,gif,ief,jpeg,jpg,jpe,xwd,tiff,tif,bmp,ico,pdf,doc,docx,ppt,pptx,png,cvv,xls,xlsx,xlt,csv,bmp,xlc,xla,xps,eml,oft,msg"
							placeholder="Choose an Attachment" style="Emphasized"></u:FileUploader>
					</VBox>
				</form:content>
			</form:SimpleForm>
		</content>
		<buttons>
		<Button text="Upload" press="onRemAttachUpload"/>
        <Button text="Cancel" press="onRemAttachUploadCancel"/>
		</buttons>
	</Dialog>
</core:FragmentDefinition>