<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:mvc="sap.ui.core.mvc" xmlns:layout="sap.ui.layout" xmlns:f="sap.f"
	xmlns:fb="sap.ui.comp.filterbar">
	<Dialog id="idUserHelpDialog" title="Select User" draggable="true" resizable="true">
		<VBox>
			<fb:FilterBar id="filterbar" reset="onReset" search="onUserSearch" useToolbar="false" showGoOnFB="true">
				<fb:filterItems>
					
					<fb:FilterItem name="B" label="User">
						<fb:control>
							<Input id="idUser" submit="onUserSearch"/>
						</fb:control>
					</fb:FilterItem>
					<fb:FilterItem name="C" label="First Name">
						<fb:control>
							<Input id="idFname" submit="onUserSearch"/>
						</fb:control>
					</fb:FilterItem>
					<fb:FilterItem name="D" label="Last Name">
						<fb:control>
							<Input id="idLname" submit="onUserSearch"/>
						</fb:control>
					</fb:FilterItem>
				</fb:filterItems>
			</fb:FilterBar>
			<!--		</f:content>-->
			<!--	</f:DynamicPageHeader>-->
			<!--</f:header>-->
			<!-- DynamicPage Content -->
			<!--<f:content>-->
			<Table id="idProductsTable" inset="false" growing = "true" growingScrollToLoad = "true" growingThreshold ="100" threshold="50" items="{UsersList>/}" mode="SingleSelectMaster" selectionChange="handleCloseUserValueHelp"
				itemPress="handleCloseUserValueHelp">
				<columns>
					<Column minScreenWidth="Tablet" demandPopin="true">
						<Text text="User"/>
					</Column>
					<Column minScreenWidth="Tablet" demandPopin="true">
						<Text text="First Name"/>
					</Column>
					<Column minScreenWidth="Tablet" demandPopin="true">
						<Text text="Last Name"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle">
						<cells>
							<Text text="{UsersList>BNAME}"/>
							<Text text="{UsersList>FNAME}"/>
							<Text text="{UsersList>LNAME}"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			<!--	</f:content>-->
			<!--</f:DynamicPage>-->
		</VBox>
		<endButton>
			<Button text="Close" press="onCloseUserPopup"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>