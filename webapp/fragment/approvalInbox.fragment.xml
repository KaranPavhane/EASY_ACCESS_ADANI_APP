			<t:Table class="sapUiSizeCompact" id="approverInboxTable" visibleRowCount="15" rows="{/myItems}" ariaLabelledBy="title" selectionMode="None">
				<t:extension>
					<OverflowToolbar>
						<Title id="title" text=""/>
					</OverflowToolbar>
				</t:extension>
				<t:columns>
					<t:Column hAlign="Center" sortProperty="ExternalKeyDis" autoResizable="true">
						<Text text="Request No."/>
						<t:template>
							<Text text="{ExternalKeyDis}"/>
						</t:template>
					</t:Column>
					<t:Column hAlign="Center" sortProperty="InstanceStatus" autoResizable="true">
						<Text text="Request Type"/>
						<t:template>
							<ObjectStatus text="{path: 'InstanceStatus'}" active="true"
								state="{path: 'InstanceStatus', formatter: '.formatter.AccessRequestStatusState'}" press="onAppInboxClick"/>
							<!--<Text text="{InstanceStatus}"/>-->
						</t:template>
					</t:Column>
					<!--<t:Column hAlign="Center" sortProperty="ExternalKeyDis" autoResizable="true" width="12rem">-->
