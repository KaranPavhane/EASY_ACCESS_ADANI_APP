					<t:Column hAlign="Center" sortProperty="ExternalKeyDis" autoResizable="true">
						<Text text="Raised By"/>
						<t:template>
							<Text text="{CreatedBy}"/>
						</t:template>
					</t:Column>
					<t:Column hAlign="Center" sortProperty="ExternalKeyDis" autoResizable="true">
						<Text text="Raised For"/>
						<t:template>
							<Text text="{raised_for}"/>
						</t:template>
					</t:Column>
					<t:Column hAlign="Center" sortProperty="CreatedAt" autoResizable="true">
						<Text text="Raised On"/>
						<t:template>
							<Text text="{ path: 'CreatedAt', type: 'sap.ui.model.type.Date'}" wrapping="false"/>
							<!--<Text text="{CREATED_ON}"/>-->
						</t:template>
					</t:Column>
