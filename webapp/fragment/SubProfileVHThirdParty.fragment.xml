<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="subProfileSelectDialogThirdParty"
        title="Select Sub-Profile"
         multiSelect="true"
        items="{ProfileModel>/oSubProfiles}"   
        confirm="onSubProfileConfirm"
        liveChange="onSubProfileSearch"
    >
        <StandardListItem
            title="{ProfileModel>SUB_PROFILE}"     
            description="{ProfileModel>SUB_PROFILE}"  
        />
    </SelectDialog>
</core:FragmentDefinition>
