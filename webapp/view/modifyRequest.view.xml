    <VBox class="sapUiSmallMargin">
        <f:SimpleForm class="sapUiSizeCompact" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
            labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
            singleContainerFullSize="false">
            <f:content>
                <core:Title text="Request Details"/>
                <Label text="Request For"/>
                <Select id="SlUserRef" change="onSelectModifierA">
                    <items>
                        <core:Item text="Self" key="Self"/>
                        <core:Item text="Other User" key="Other"/>
                        <!--<core:Item text="My Reportees" key="Multiple"/>-->
                    </items>
                </Select>
                <Label text="User" required="true"/>
                <!--<Input width="85%" id="userId" value="{Street}"></Input>-->
                <!--    <ComboBox id="idComboUserMod" items="{path:'/myItems'}" editable="false" width="75%" selectionChange="onUserChangeMod">
                    <core:Item text="{USER_ID}" key="{USER_ID}"/>
                </ComboBox>-->
                <VBox>
                    <Input id="idComboUserMod" showValueHelp="true" submit="onUserSubmit" editable="false"  valueHelpRequest="onValueHelpUsers" valueHelpOnly="true"/>
                    <Text id="idNameMod"></Text>
                </VBox>
                <Label required="true" text="Business Process" id="idBusinessProcess"/>
