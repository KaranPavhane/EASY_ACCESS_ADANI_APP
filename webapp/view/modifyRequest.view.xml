                            </Column>
                            <Column>
                                <Text class="myCustomText" text="ID Exist"/>
                            </Column>
                        </columns>
                        <dragDropConfig>
                            <dnd:DragInfo groupName="available2selected" sourceAggregation="items"/>
                            <dnd:DropInfo groupName="selected2available" drop="onDropSelectedProductsTableModS"/>
                        </dragDropConfig>
                        <ColumnListItem class="myCustomText" id="detailsListItem1Mod">
                            <cells>
                                <Text text="{SysLandInfoMod>CONNECTOR}" wrapping="false"/>
                                <Text text="{SysLandInfoMod>RFCDOC1}" wrapping="false"/>
                                <Text text="{= ${SysLandInfoMod>EXIST} === 'X' ? 'No' : 'Yes' }" wrapping="false"/>
                            </cells>
                        </ColumnListItem>
                    </Table>
                    <VBox justifyContent="Center" class="sapUiTinyMarginBeginEnd">
                        <!--<Button class="sapUiTinyMarginBottom" icon="sap-icon://navigation-right-arrow" tooltip="Move to selected" press="moveToTable2"/>-->
                        <!--<Button icon="sap-icon://navigation-left-arrow" tooltip="Move to available" press="moveToTable1"/>-->
                    </VBox>
                    <Table class="sapUiSizeCompact" visible="false" id="table2Mod" items="{ path: 'SeleSysLandInfoMod>/sleSysLaData' }">
