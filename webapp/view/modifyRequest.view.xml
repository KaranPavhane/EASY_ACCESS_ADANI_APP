                <f:SimpleForm class="sapUiSizeCompact">
                    <Toolbar width="100%">
                        <Button id="idNewRoleNextMod" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:Attachments" press="onNextStepModify"
                            textDirection="LTR"/>
                        <ToolbarSpacer/>
                    </Toolbar>
                </f:SimpleForm>
            </WizardStep>
           
            <WizardStep id="PricingStep423" nextStep="PricingStep526" title="Attachments" activate="onActivate">
                <MessageStrip showIcon="true"
                    text="Attach the files that are relavant to this request. For eg: Approval emails etc., either in PDF format or JPG Format. You need not attach the list of transaction codes again here."
                    class="sapUiMediumMarginTop"/>
                <Text class="sapUiSmallMarginBottom" text=""/>
                <Table class="sapUiSizeCompact" visible="true" inset="false" items="{AttInfoModelMod>/AttInfoData}">
                    <headerToolbar>
                        <OverflowToolbar>
                            <ToolbarSpacer/>
                            <Button icon="sap-icon://add" type="Emphasized" text="Attach" press="getAttachDialog"/>
                        </OverflowToolbar>
                    </headerToolbar>
                    <columns>
                        <Column>
                            <Text text="Title"/>
                        </Column>
                        <Column hAlign="Center">
                            <Text text="File Type"/>
                        </Column>
                        <Column hAlign="Center">
                            <Text text="Added on"/>
                        </Column>
                        <Column hAlign="Center">
                            <Text text="Added By"/>
                        </Column>
                        <Column width="50px"/>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle" type="Inactive">
                            <cells>
                                <Input width="70%" value="{AttInfoModelMod>tile}" editable="false"/>
                                <Input width="70%" value="{AttInfoModelMod>type}" editable="false"/>
                                <Text width="70%" text="{
                                    path: 'AttInfoModelMod>addedOn',
                                    type: 'sap.ui.model.type.Date',
                                    formatOptions: {
                                        style: 'medium'
                                    }
                                }"/>
                                <Input width="70%" value="{AttInfoModelMod>addedBy}" editable="false"/>
                                <Button icon="sap-icon://delete" press="deleteRowRole" type="Reject"/>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <f:SimpleForm class="sapUiSizeCompact">
                    <Toolbar width="100%">
                        <Button id="idNextReqSubMod" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:Request Submission" press="onNextStepModify" textDirection="LTR"/>
                        <ToolbarSpacer/>
                    </Toolbar>
                </f:SimpleForm>
            </WizardStep>
            <WizardStep id="PricingStep526" title="Review Request" activate="onActivate">
                <MessageStrip showIcon="true"
                    text="Review your request here before submitting it. We have consolidated all your requirement in a single screen for you to quickly review before the actual submission. Once the request is submitted, it will be approved by various approvers. You will be notified at every stage."
                    class="sapUiMediumMarginTop"/>
                    <ToolbarSpacer/>
                    <Button icon="sap-icon://refresh" type="Emphasized" text="Refresh Request Submission" press="onNextStepModify"/>
