                                </ComboBox>
                                <Input value="{TcodeModelMod>Tcode}" tooltip="{TcodeModelMod>Tcode}" maxLength="20" valueState="{=${TcodeModelMod>TcodeDesc} ? 'None' :'Error'}" change="onTcodeChangeMod" liveChange="handleLiveChange" name="Tcode" valueStateText="Please Enter Valid Tcode" placeholder="Please Enter Valid Tcode"></Input>
