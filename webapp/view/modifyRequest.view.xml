                                <Input value="{OrgTableModelMod>OrgVal}" editable="false"  tooltip="{OrgTableModelMod>OrgVal}" ></Input>
                                <Input value="{OrgTableModelMod>Tcode}" tooltip="{OrgTableModelMod>Tcode}" editable="false" liveChange="handleLiveChange"></Input>
                                <!-- <Input value="{OrgTableModelMod>FromOrg}" showValueHelp="true"  name="AlphaNum" liveChange="handleLiveChange" valueHelpRequest="onOrgFromMod"></Input> -->
                                <HBox width="100%" renderType="Bare">
                                <Input value="{OrgTableModelMod>FromOrg}"   tooltip="{OrgTableModelMod>FromOrg}"  showValueHelp="false"  name="AlphaNum" liveChange="handleLiveChange" editable="false" />
                                <Button icon="sap-icon://value-help" press="onOrgFromMod" enabled="{OrgTableModelMod>FromOrgValueHelp}" class="sapUiTinyMarginBeginEnd"></Button>
                                <Button icon="sap-icon://add" press="addNewOrgMod"  enabled="{OrgTableModelMod>FromOrgValueAdd}" type="Accept"/>
 
                                </HBox>
                                <!--<Input value="{OrgTableModelMod>ToOrg}" showValueHelp="true" valueHelpRequest="onOrgTo"></Input>-->
                                <Button icon="sap-icon://delete" type="Reject" press="removeNewOrgMod" visible="{= ${OrgTableModelMod>isNew} === true }"/>
 
                                <!--<Button id="idRemoveOrgMod" icon="sap-icon://decline" press="removeNewOrgMod" type="Reject"-->
                                <!--    enabled="{= ${OrgTableModelMod>OrgLevel} !== 'WERKS' &amp;&amp; ${OrgTableModelMod>OrgLevel} !== 'BUKRS'}"/>-->
                                <!-- <Button icon="sap-icon://delete" press="deleteNewOrgNew" type="Accept"/> -->
                            </cells>
