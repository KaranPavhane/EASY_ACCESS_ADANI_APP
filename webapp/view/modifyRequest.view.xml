                        <Label text="Request raised for"/>
                        <Text id="idReqRaisedForMod" text="{userInfo>/USER_ID}"/>
                        <Label text="Tcodes"/>
                        <Text id="idTcodesListMod"/>
                        <core:Title text=""/>
                        <Label text="Firstname"/>
                        <Text id="txtFnameReviewRequestMod" text="{userInfo>/FIRST_NAME}"/>
                        <Label text="Lastname"/>
                        <Text id="txtLnameReviewRequestMod" text="{userInfo>/LAST_NAME}"/>
                    </f:content>
                </f:SimpleForm>
               
                <f:SimpleForm class="sapUiSizeCompact">
