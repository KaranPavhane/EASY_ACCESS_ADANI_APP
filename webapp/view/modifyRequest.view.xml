  <Text text=""/>
</Column>
                    </columns>
                    <items>
                        <ColumnListItem vAlign="Middle" type="Inactive">
                            <cells>
                                <!--<Input value="{OrgTableModelMod>OrgLevel}" editable="false"></Input>-->
                                <Input value="{OrgTableModelMod>Conn}" editable="false" tooltip="{OrgTableModelMod>Conn}" ></Input>
                                <!-- <Input value="{OrgTableModelMod>OrgVal}" editable="false"  tooltip="{OrgTableModelMod>OrgVal}" ></Input> -->
                                <Input value="{OrgTableModelMod>Tcode}" tooltip="{OrgTableModelMod>Tcode}" editable="false" liveChange="handleLiveChange"></Input>
                                <Input width="100%" value="{OrgTableModelMod>Profile}" showValueHelp="true" valueHelpOnly="true" editable="{OrgTableModelMod>Editable}" valueHelpRequest="onProfileF4Help" placeholder="Select Profile"/>
<Input width="100%" value="{OrgTableModelMod>SubProfile}" placeholder="Select Sub-Profile" showValueHelp="true" valueHelpRequest="onSubProfileVH"  enabled="{OrgTableModelMod>Editable}"/>
<Input
    width="100%"
    value="{OrgTableModelMod>DESIGNTION}"
    placeholder="Select Designation(s)"
    showValueHelp="true"
    valueHelpOnly="true"
    enabled="{OrgTableModelMod>Editable}"
    valueHelpRequest="onDesignationVH"
     />
     <Button
    icon="sap-icon://delete"
    type="Reject"
