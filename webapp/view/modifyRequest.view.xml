                        <Column hAlign="Center">
                            <Text text="Tcode"/>
                        </Column>
                        <Column hAlign="Center">
                            <Text text="Value"/>
                        </Column>
                        <Column width="50px">
                            <Text text=""></Text>
                        </Column>
                    </columns>
