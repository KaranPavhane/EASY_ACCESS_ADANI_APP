                </Table>
                <f:SimpleForm class="sapUiSizeCompact">
                    <Toolbar width="100%">
                        <Button id="idNewOrgNextMod" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:Organization value Information"
                            press="onNextStepModify" textDirection="LTR"/>
                        <ToolbarSpacer/>
                    </Toolbar>
                </f:SimpleForm>
            </WizardStep>
            <WizardStep id="PricingStep12" nextStep="PricingStep221" title="Organization value Information" activate="onActivate">
                <MessageStrip showIcon="true"
                    text="These organization values are picked up based on your current access. Incase, if you are requesting for the 1st time, you may select/enter the values manually. Ensure to fill-in all the fields to ensure you get access to the right roles."
