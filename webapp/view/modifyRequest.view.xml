                        </Column>
                        <Column>
                            <Text text="Transaction Code"/>
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Transaction Description"/>
                        </Column>
                        <Column width="50px">
                            <Text text=""></Text>
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
