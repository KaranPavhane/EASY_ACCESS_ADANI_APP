<mvc:View xmlns="sap.m" controllerName="com.new.prjt.znew_arm_prjt.controller.FFAccess" xmlns:f="sap.ui.layout.form" xmlns:mvc="sap.ui.core.mvc"
	xmlns:l="sap.ui.layout" height="100%" xmlns:t="sap.ui.table" xmlns:dnd="sap.ui.core.dnd" displayBlock="true" xmlns:core="sap.ui.core">
	<VBox class="sapUiSmallMargin">
		<f:SimpleForm class="sapUiSizeCompact" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
			labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
			singleContainerFullSize="false">
			<f:content>
				<core:Title text="Request Details"/>
				<Label text="Request For"/>
				<Select id="idFFComboUserType" change="onSuerSelectFF">
					<core:Item key="self" text="Self"/>
					<core:Item key="others" text="Other User"/>
				</Select>
				<Label text="User" required="true"/>
				<VBox>
					<Input id="idComboUser2FF" showValueHelp="true"  submit="onUserSubmit" editable="false" valueHelpOnly="true"  valueHelpRequest="onValueHelpUsers"/>
					<Text id="idNameFF"></Text>
				</VBox>
				<core:Title text=" "/>
				<Label text=" Description"/>
				<TextArea required="true" id="idFfidText" name="AlphaNum" liveChange="" valueStateText="Please Enter Access Requirement" maxLength="120" rows="3"
					cols="30"/>
			</f:content>
		</f:SimpleForm>
	</VBox>
	<Wizard id="CreateProductWizardId261" finishButtonText="Finish" showNextButton="false" currentStep="idFireUserFF1"
		class="sapUiResponsivePadding--header sapUiResponsivePadding--content">
		<WizardStep id="idFireUserFF1" nextStep="ProductTypeStep3" title="User Information" activate="onActivate">
			<MessageStrip showIcon="true"
				text="Enter your Personal Information. This information is saved in all the SAP systems and will be utilized for further communications such as new password, etc., Ensure you provide the right details!"
				class="sapUiMediumMarginTop"/>
			<f:SimpleForm class="sapUiSizeCompact" id="idFFPersonal1" editable="false" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4"
				labelSpanM="12" labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3"
				columnsL="3" columnsM="3" singleContainerFullSize="false">
				<f:content>
					<core:Title text="Personal"/>
					<Label required="true" text="First Name"/>
					<Input id="idFfFName" value="{userInfo1>/FIRST_NAME}" editable="false" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter First Name"></Input>
					<Label required="true" text="Last Name"/>
					<Input id="idFfLName" value="{userInfo1>/LAST_NAME}" editable="false" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter Last Name"></Input>
					<Label required="true" text="Employee Type"/>
					<Select width="85%" id="idFfEmpType" items="{ path: 'EmployeeTypeMod>/' }" valueStateText="Please Enter Emp Type"
						editable="{= ${userInfo1>/EMPTYPE} === ''}" change="onValidatationCheck" >
						<core:Item key="{EmployeeTypeMod>key}" text="{EmployeeTypeMod>text}"/>
					</Select>
					<core:Title text="Reporting Details"/>
					<Label required="true" text="Reporting Manager"/>
					<Input id="idFfRepMana" value="{userInfo1>/ZRMRMID}" editable="false" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter Reporting Manager "></Input>
					<Label text="Personal Number"/>
					<Input id="idFfPNumber" value="{userInfo1>/ZEMPID}" editable="false" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter Personal Number "></Input>
					<core:Title text="Department"/>
					<Label required="false" text="Department"/>
					<Input id="idFfDept" value="{userInfo1>/DEPARTMENT}" editable="true" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter Department "></Input>
					<core:Title text="Communication"/>
					<Label text="Mobile Number"/>
					<!-- editable="{=${userInfo1>/PHONE} === '' ? true: false}" -->
					<MaskInput mask = "9999999999"  id="idFfMNumber"  value="{userInfo1>/PHONE}"  width="85%" change="onValidatationCheck"
						valueStateText="Please Enter Mobile Number "></MaskInput>
					<Label required="true" text="Email"/>
					<Input id="idFfEmail" value="{userInfo1>/EMAIL}" editable="false" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter Email"></Input>
					<core:Title id="idFF3rdPary"/>
					<Label text="Adani Reporting MGR EMP ID"/>
					<Input visible="false" id="idFfEmpId" value="{userInfo1>/ZRMRMID}" editable="false" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter EMP ID"></Input>
					<Label text="Vendor Name"/>
					<Input visible="false" id="idFfVenNum" value="{userInfo1>/VENDORNAME}" width="85%" change="onValidatationCheck"
						valueStateText="Please Enter Vendor Number"></Input>
				</f:content>
			</f:SimpleForm>
			<f:SimpleForm class="sapUiSizeCompact">
				<Toolbar width="100%">
					<Button id="idFFButSys" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:System/Landscape Information"
						press="onNextStepFireFighter" textDirection="LTR"/>
					<ToolbarSpacer/>
				</Toolbar>
			</f:SimpleForm>
		</WizardStep>
		<WizardStep id="ProductInfoStep26" nextStep="ProductTypeStep3" title="System/Landscape Information" activate="onActivate">
			<HBox renderType="Bare">
				<Table class="sapUiSizeCompact" id="table1FF" items="{ path: 'SysLandInfoFF>/SysLaData' }" beforeOpenContextMenu="onBeforeOpenContextMenu"
					mode="MultiSelect" selectionChange="onSelectionChangeSystemFfid">
					<contextMenu>
						<Menu>
							<MenuItem text="Move to Selected Products" press="moveToSelectedProductsTable"/>
						</Menu>
					</contextMenu>
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Available System"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text class="myCustomText" text="System"/>
						</Column>
						<Column>
							<Text class="myCustomText" text="Description"/>
						</Column>
					</columns>
					<dragDropConfig>
						<dnd:DragInfo groupName="available2selected" sourceAggregation="items"/>
						<dnd:DropInfo groupName="selected2available" drop="onDropAvailableSysLandSFF"/>
					</dragDropConfig>
					<ColumnListItem class="myCustomText" id="detailsListItem1FF">
						<cells>
							<Text text="{SysLandInfoFF>CONNECTOR}" wrapping="false"/>
							<Text text="{SysLandInfoFF>RFCDOC1}" wrapping="false"/>
						</cells>
					</ColumnListItem>
				</Table>
				<Table class="sapUiSizeCompact" visible="false" id="table2FF" items="{ path: 'SeleSysLandInfoFF>/sleSysLaData' }">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Selected System"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text class="myCustomText" text="System"/>
						</Column>
						<Column>
							<Text class="myCustomText" text="Description"/>
						</Column>
					</columns>
					<dragDropConfig>
						<dnd:DragInfo groupName="selected2available" sourceAggregation="items"/>
						<dnd:DropInfo groupName="available2selected" targetAggregation="items" dropPosition="Between" drop="onDropAvailableSysLandFF"/>
						<dnd:DragDropInfo sourceAggregation="items" targetAggregation="items" dropPosition="Between" drop="onDropAvailableSysLandFF"/>
					</dragDropConfig>
					<ColumnListItem class="myCustomText">
						<cells>
							<Text text="{SeleSysLandInfoFF>CONNECTOR}" wrapping="false"/>
							<Text text="{SeleSysLandInfoFF>RFCDOC1}" wrapping="false"/>
						</cells>
					</ColumnListItem>
				</Table>
			</HBox>
			<f:SimpleForm class="sapUiSizeCompact">
				<Toolbar width="100%">
					<Button id="idFFButGetFFID" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:Firefighter IDs" press="onNextStepFireFighter"
						textDirection="LTR"/>
					<ToolbarSpacer/>
				</Toolbar>
			</f:SimpleForm>
		</WizardStep>
		<WizardStep id="OptionalInfoStep26" nextStep="ProductTypeStep3" title="Firefighter IDs" activate="onActivate">
			<HBox renderType="Bare">
				<Table class="sapUiSizeCompact" id="DragTableFireFighterID" items="{FireFiIds>/FireFiId}" mode="MultiSelect" growing="true"
					growingThreshold="5">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Firefighter IDs Available"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text class="myCustomText" text="Firefighter IDs"/>
						</Column>
						<Column>
							<Text class="myCustomText" text="Description"/>
						</Column>
						<Column>
							<Text class="myCustomText" text="System"/>
						</Column>
					</columns>
					<dragDropConfig>
						<dnd:DragInfo groupName="moveToTable2" sourceAggregation="items"/>
						<dnd:DropInfo groupName="moveToTable1" drop="FFselectedIdDrop"/>
					</dragDropConfig>
					<ColumnListItem class="myCustomText">
						<cells>
							<Text text="{FireFiIds>FFOBJECT}" wrapping="false"/>
							<Text text="{FireFiIds>APP_TYPE}" wrapping="false"/>
							<Text text="{FireFiIds>CONNECTOR}" wrapping="false"/>
						</cells>
					</ColumnListItem>
				</Table>
				<Table class="sapUiSizeCompact" visible="false" id="DropTableFireFighterID" items="{FireFiIdsel>/FireFiId}">
					<headerToolbar>
						<OverflowToolbar>
							<Title text="Firefighter IDs Selected"/>
							<ToolbarSpacer/>
							<Button icon="sap-icon://refresh" type="Emphasized" text="Refresh FFIDs" press="onFFRefresh"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text class="myCustomText" text="Firefighter IDs"/>
						</Column>
						<Column>
							<Text class="myCustomText" text="Description"/>
						</Column>
						<Column>
							<Text class="myCustomText" text="System"/>
						</Column>
					</columns>
					<dragDropConfig>
						<dnd:DragInfo groupName="moveToTable1" sourceAggregation="items"/>
						<dnd:DropInfo groupName="moveToTable2" targetAggregation="items" dropPosition="Between" drop="FFselectedId"/>
						<dnd:DragDropInfo sourceAggregation="items" targetAggregation="items" dropPosition="Between" drop="FFselectedId"/>
					</dragDropConfig>
					<ColumnListItem class="myCustomText">
						<cells>
							<Text text="{FireFiIdsel>FFOBJECT}" wrapping="false"/>
							<Text text="{FireFiIdsel>APP_TYPE}" wrapping="false"/>
							<Text text="{FireFiIdsel>CONNECTOR}" wrapping="false"/>
						</cells>
					</ColumnListItem>
				</Table>
			</HBox>
			<f:SimpleForm class="sapUiSizeCompact">
				<Toolbar width="100%">
					<Button id="idFFButFFID" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:Firefighter Validity" press="onNextStepFireFighter"
						textDirection="LTR"/>
					<ToolbarSpacer/>
				</Toolbar>
			</f:SimpleForm>
		</WizardStep>
		<WizardStep id="PricingStep12656" nextStep="ProductTypeStep3" title="Firefighter Validity" activate="onActivate">
			<MessageStrip showIcon="true"
				text="Attach the files that are relavant to this request. For eg: Approval emails etc., either in PDF format or JPG Format. You need not attach the list of transaction codes again here."
				class="sapUiMediumMarginTop"/>
			<Table id="idFFValidTable" class="sapUiSizeCompact" items="{FFVlid>/ffvData}" visible="true"  inset="false">
				<headerToolbar>
					<OverflowToolbar>
						<ToolbarSpacer/>
						<Button icon="sap-icon://refresh" type="Emphasized" text="Refresh FFIDs" press="onFFIDRefresh"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="Firefighter IDs"/>
					</Column>
					<Column hAlign="Center" width="12em" minScreenWidth="Tablet" demandPopin="true">
						<Text text="System"/>
					</Column>
					<Column hAlign="End">
						<Text text="Valid From"/>
					</Column>
					<Column hAlign="End">
						<Text text="Valid To"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle" type="Inactive">
						<cells>
							<Input value="{FFVlid>FFOBJECT}" editable="false"/>
							<Input value="{FFVlid>CONNECTOR}" editable="false"/>
							<DatePicker name ="fromDate" value="{path:'FFVlid>VALID_FROM'}" valueFormat="yyyyMMdd" displayFormat="long" change="handleChangeToAndFrom"/>
							<DatePicker name ="toDate"  value="{path:'FFVlid>VALID_TO'}" valueFormat="yyyyMMdd" displayFormat="long" change="handleChangeToAndFrom"/>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			<f:SimpleForm class="sapUiSizeCompact">
				<Toolbar width="100%">
					<Button id="idFFButReqSub" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:Attachments" press="onNextStepFireFighter"
						textDirection="LTR"/>
					<ToolbarSpacer/>
				</Toolbar>
			</f:SimpleForm>
		</WizardStep>
		<WizardStep id="PricingStep423" nextStep="ProductTypeStep3" title="Attachments" activate="onActivate">
				<MessageStrip showIcon="true"
					text="Attach the files that are relavant to this request. For eg: Approval emails etc., either in PDF format or JPG Format. You need not attach the list of transaction codes again here."
					class="sapUiMediumMarginTop"/>
				<Text class="sapUiSmallMarginBottom" text=""/>
				<Table class="sapUiSizeCompact" visible="true" inset="false" items="{FFInfoModelMod>/AttInfoData}">
					<headerToolbar>
						<OverflowToolbar>
							<ToolbarSpacer/>
							<Button icon="sap-icon://add" type="Emphasized" text="Attach" press="getAttachDialog"/>
						</OverflowToolbar>
					</headerToolbar>
					<columns>
						<Column>
							<Text text="Title"/>
						</Column>
						<Column hAlign="Center">
							<Text text="File Type"/>
						</Column>
						<Column hAlign="Center">
							<Text text="Added on"/>
						</Column>
						<Column hAlign="Center">
							<Text text="Added By"/>
						</Column>
						<Column width="50px"/>
					</columns>
					<items>
						<ColumnListItem vAlign="Middle" type="Inactive">
							<cells>
								<Input width="70%" value="{FFInfoModelMod>tile}" editable="false"/>
								<Input width="70%" value="{FFInfoModelMod>type}" editable="false"/>
								<Text width="70%"  text="{
									path: 'FFInfoModelMod>addedOn',
									type: 'sap.ui.model.type.Date',
									formatOptions: {
										style: 'medium'
									}
								}"/>
								<Input width="70%" value="{FFInfoModelMod>addedBy}" editable="false"/>
								<Button icon="sap-icon://delete" press="deleteRowRole" type="Reject"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<f:SimpleForm class="sapUiSizeCompact">
					<Toolbar width="100%">
						<Button id="idNextReqSubAtc" type="Emphasized" icon="sap-icon://arrow-bottom" text="Next:Request Submission" press="onNextStepFireFighter" textDirection="LTR"/>
						<ToolbarSpacer/>
					</Toolbar>
				</f:SimpleForm>
			</WizardStep>
		<WizardStep id="PricingStep226" nextStep="ProductTypeStep3" title="Review Request" activate="onActivate">
			<MessageStrip showIcon="true"/>
			<f:SimpleForm class="sapUiSizeCompact" editable="true" layout="ResponsiveGridLayout" labelSpanXL="4" labelSpanL="4" labelSpanM="4"
				labelSpanS="12" adjustLabelSpan="false" emptySpanXL="0" emptySpanL="0" emptySpanM="0" emptySpanS="0" columnsXL="3" columnsL="2" columnsM="2"
				singleContainerFullSize="false">
				<f:content>
					<core:Title text="Review"/>
					<Label text="Request Raised by"/>
					<Text text="{navModel>/oResult/user_id}"/>
					<Label text="Request Raised for"/>
					<Text text="{userInfo1>/USER_ID}"/>
					<core:Title text=""/>
					<Label text="First Name"/>
					<Text text="{userInfo1>/FIRST_NAME}"/>
					<Label text="Last Name"/>
					<Text text="{userInfo1>/LAST_NAME}"/>
				</f:content>
			</f:SimpleForm>
			<Table id="idFfidSelTable" items="{ path: '/FfidSelData'}" class="sapUiSizeCompact" visible="true" mode="None" inset="false">
				<headerToolbar>
					<OverflowToolbar>
						<ToolbarSpacer/>
						<Button id="idFfidUpdSelBut" type="Emphasized" text="Update FFID Information" press="onFfidUpdateSeleTable" textDirection="LTR"/>
					</OverflowToolbar>
				</headerToolbar>
				<columns>
					<Column>
						<Text text="Firefighter ID"/>
					</Column>
					<Column >
						<Text text="System"/>
					</Column>
					<Column>
						<Text text="Valid From"/>
					</Column>
					<Column>
						<Text text="Valid To"/>
					</Column>
				</columns>
				<items>
					<ColumnListItem vAlign="Middle" type="Inactive">
						<cells>
							<Text text="{FFOBJECT}"/>
							<Text text="{CONNECTOR}"/>
							<Text id="idFFFinalDateFrom" text="{VALID_FROM}"/>
							<Text id="idFFFinalDateTo" text="{VALID_TO}"/>
							<Input></Input>
						</cells>
					</ColumnListItem>
				</items>
			</Table>
			<f:SimpleForm class="sapUiSizeCompact">
				<Toolbar width="100%">
					<Label id="lblFisdsleNrgrame3fe4" text="" class="filename"/>
					<ToolbarSpacer/>
					<Button type="Accept" icon="sap-icon://complete" text="Submit" press="onSubmitFF" textDirection="LTR"/>
					<Button type="Reject" icon="sap-icon://cancel" text="Cancel" textDirection="LTR" press="onCancelFF"/>
				</Toolbar>
			</f:SimpleForm>
		</WizardStep>
	</Wizard>
</mvc:View>